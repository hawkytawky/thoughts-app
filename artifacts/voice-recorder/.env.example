# Local development only. EAS builds do not read this file — it is gitignored,
# so the same three values are set per build profile in eas.json. Change one,
# change the other.
#
# None of these are secrets: every EXPO_PUBLIC_ value is compiled into the app
# bundle and can be read out of any installed build.

# Authenticated cloud API.
EXPO_PUBLIC_THOUGHTS_API_URL=https://thoughts-api.example.azurecontainerapps.io
# Google OAuth iOS client ID (Google Cloud Console -> Credentials -> iOS client).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<google-ios-client-id>.apps.googleusercontent.com
# Google OAuth Web client ID (used as the backend/server client ID).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<google-web-client-id>.apps.googleusercontent.com
# Optional locally; EAS builds normally provide this through Constants.easConfig.
EXPO_PUBLIC_EAS_PROJECT_ID=<eas-project-uuid>
