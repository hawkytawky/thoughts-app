# Authenticated cloud API.
EXPO_PUBLIC_THOUGHTS_API_URL=https://thoughts-api.example.azurecontainerapps.io
EXPO_PUBLIC_ENTRA_AUTHORITY=https://<tenant-name>.ciamlogin.com/<tenant-id>/v2.0
EXPO_PUBLIC_ENTRA_IOS_CLIENT_ID=<thoughts-ios-application-client-id>
EXPO_PUBLIC_ENTRA_API_SCOPE=api://<thoughts-api-application-client-id>/recordings.readwrite
EXPO_PUBLIC_ENTRA_REDIRECT_URI=msauth.com.otto.thoughts://auth
