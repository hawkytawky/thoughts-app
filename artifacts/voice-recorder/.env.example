# Authenticated cloud API.
EXPO_PUBLIC_THOUGHTS_API_URL=https://thoughts-api.example.azurecontainerapps.io
# Google OAuth iOS client ID (Google Cloud Console -> Credentials -> iOS client).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<google-ios-client-id>.apps.googleusercontent.com
# Google OAuth Web client ID (used as the backend/server client ID).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<google-web-client-id>.apps.googleusercontent.com
