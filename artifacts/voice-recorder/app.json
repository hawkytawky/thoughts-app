{
  "expo": {
    "name": "thoughts",
    "slug": "thoughts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "thoughts"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#EAF2F8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.otto.thoughts",
      "buildNumber": "3",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.otto.thoughts"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "Allow thoughts to access your microphone to record audio."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Erlaube thoughts, deinen Standort zu verwenden, damit jeder thought automatisch Stadt und Stadtteil erhält."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.660632473974-ee1pilng805otr2ta2d6s83v7iq7q6dl"
        }
      ],
      "expo-live-activity",
      "./plugins/withModularHeaders",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.2"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
